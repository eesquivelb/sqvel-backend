    let vis = false;
    window.addEventListener('mousemove', e=>{
      dot.style.left = e.clientX + 'px'; dot.style.top = e.clientY + 'px';
      if(!vis){ dot.style.opacity = '1'; vis = true; }
      const el = document.elementFromPoint(e.clientX, e.clientY);
      const onDark = el && el.closest('.edition, .circle, nav.scrolled, .topbar, .product-visual, .marquee-wrap, .preloader');
      const interactive = el && el.closest('a, button, input, .product-card, .size-chip');
      dot.classList.toggle('ring', !!interactive);
      dot.classList.toggle('on-dark', !!onDark);
    });
    window.addEventListener('mouseleave', ()=>{ dot.style.opacity = '0'; vis = false; });
  }

  // ---- nav background on scroll ----
  const navEl = document.getElementById('nav');
  window.addEventListener('scroll', ()=>{
    navEl.classList.toggle('scrolled', window.scrollY > 60);
  }, {passive:true});

  // ---- sticky buy bar: appears once past the hero, hides near the footer ----
  const stickyBuy = document.getElementById('stickyBuy');
  if(stickyBuy){
    window.addEventListener('scroll', ()=>{
      const pastHero = window.scrollY > window.innerHeight * 0.9;
      const nearFooter = (document.body.scrollHeight - (window.scrollY + window.innerHeight)) < 500;
      stickyBuy.classList.toggle('show', pastHero && !nearFooter);
    }, {passive:true});
  }

  // ---- ad/analytics event helper — fires to GA4 + Meta Pixel if their
  // scripts loaded (see the placeholder IDs in <head>); no-ops harmlessly
  // otherwise, so this never breaks the page while IDs are unset. ----
  function trackEvent(gaName, fbName, params){
    params = params || {};
    try{ if(typeof gtag === 'function') gtag('event', gaName, params); }catch(err){}
    try{ if(typeof fbq === 'function') fbq('track', fbName, params); }catch(err){}
  }
  trackEvent('view_item', 'ViewContent', { item_id:'drop-001', value:180, currency:'USD' });

  // ---- share buttons on the current drop ----
  document.querySelectorAll('.share-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const mode = btn.dataset.shareMode;
      const text = btn.dataset.shareText || 'SQVEL';
      const url = window.location.href.split('#')[0] + '#shop';
      const note = btn.closest('.share-row') ? btn.closest('.share-row').querySelector('[data-share-note]') : null;
      if(mode === 'native' && navigator.share){
        try{
          await navigator.share({ title:'SQVEL', text, url });
          trackEvent('share', 'Share', { method:'native' });
        }catch(err){ /* user cancelled — not an error */ }
        return;
      }
      try{
        await navigator.clipboard.writeText(url);
        if(note) note.textContent = 'Link copied.';
        trackEvent('share', 'Share', { method:'copy_link' });
      }catch(err){
        if(note) note.textContent = url;
      }
    });
  });

  // ---- generic reveal ----
  const revealEls = document.querySelectorAll('.reveal, .panel');
  const io = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); } });
  }, {threshold:0.25});
  revealEls.forEach(el=>io.observe(el));

  // ---- parallax for story panel scenes ----
  window.addEventListener('scroll', ()=>{
    document.querySelectorAll('.panel').forEach(p=>{
      const rect = p.getBoundingClientRect();
      const scene = p.querySelector('.scene');
      if(!scene) return;
      const offset = (rect.top) * 0.15;
      scene.style.transform = `translateY(${offset}px) scale(1.08)`;
    });
  }, {passive:true});

  // ---- Register/lookup a piece by identity code + email (guest, no login).
  // Attempts a real POST to the backend and shows an honest fallback if that
  // endpoint isn't deployed yet — same pattern as the buy/lead flows above. ----
  const registerForm = document.getElementById('registerForm');
  if(registerForm){
    registerForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const code = document.getElementById('regCode').value.trim();
      const email = document.getElementById('regEmail').value.trim();
      const note = document.getElementById('registerNote');
      const result = document.getElementById('lookupResult');
      const btn = registerForm.querySelector('button');
      const original = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Looking up…';
      note.textContent = '';
      result.hidden = true;
      try{
        const res = await fetch(registerForm.dataset.endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ identityCode: code, email })
        });
        if(!res.ok) throw new Error('lookup unavailable');
        const data = await res.json();
        if(data && data.found){
          document.getElementById('res-edition').textContent = data.edition || '—';
          document.getElementById('res-code').textContent = data.identityCode || code;
          document.getElementById('res-status').textContent = data.status || 'Owned';
          result.hidden = false;
          trackEvent('piece_registered', 'CompleteRegistration', {});
        } else {
          note.textContent = 'No piece found for that code and email — double check both, or contact support.';
        }
      } catch(err){
        note.textContent = `This needs ${registerForm.dataset.endpoint} on the backend to actually look up pieces.`;
      } finally {
        btn.disabled = false;
        btn.textContent = original;
      }
    });
  }

  // ---- Transfer/resell — starts a paid transfer-fee checkout session.
  // SQVEL only charges the flat re-registration fee here; the resale price
  // between owner and buyer is handled off-platform. Honest fallback if the
  // backend endpoint isn't deployed. ----
  const transferForm = document.getElementById('transferForm');
  if(transferForm){
    transferForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const note = document.getElementById('transferNote');
      const btn = transferForm.querySelector('button');
      const original = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Starting transfer…';
      note.textContent = '';
      try{
        const res = await fetch(transferForm.dataset.endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            identityCode: document.getElementById('trCode').value.trim(),
            fromEmail: document.getElementById('trFromEmail').value.trim(),
            toEmail: document.getElementById('trToEmail').value.trim()
          })
        });
        if(!res.ok) throw new Error('transfer unavailable');
        const data = await res.json();
        if(data && data.url){
          trackEvent('begin_transfer', 'InitiateCheckout', { value: 15, currency: 'USD' });
          window.location.href = data.url; return;
        }
        throw new Error('no checkout url returned');
      } catch(err){
        note.textContent = `This needs ${transferForm.dataset.endpoint} on the backend to actually start a transfer.`;
      } finally {
        btn.disabled = false;
        btn.textContent = original;
      }
    });
  }

  // ---- Reviews: a real system that ships with zero reviews — never
  // fabricated ones. Tries to load genuine reviews from the backend; if
  // that route isn't live, it falls back to the honest "no reviews yet"
  // empty state rather than showing an error or fake content. ----
  (function(){
    const list = document.getElementById('reviewsList');
    const countEl = document.getElementById('reviewsCount');
    const avgStarsEl = document.getElementById('reviewsAvgStars');
    if(!list) return;

    function starsStr(n){
      n = Math.max(0, Math.min(5, Math.round(n)));
      return '★★★★★☆☆☆☆☆'.slice(5 - n, 10 - n);
    }

    function renderReviews(reviews){
      list.innerHTML = '';
      if(!reviews || !reviews.length){
        countEl.textContent = 'No reviews yet — be the first.';
        avgStarsEl.textContent = '☆☆☆☆☆';
        return;
      }
      const avg = reviews.reduce((s,r)=>s + (r.rating||0), 0) / reviews.length;
      avgStarsEl.textContent = starsStr(avg);
      countEl.textContent = `${avg.toFixed(1)} · ${reviews.length} review${reviews.length===1?'':'s'}`;
      reviews.forEach(r=>{
        const item = document.createElement('div');
        item.className = 'review-item';
        const stars = document.createElement('div');
        stars.className = 'stars'; stars.textContent = starsStr(r.rating||0);
        const who = document.createElement('div');
        who.className = 'who'; who.textContent = r.name || 'Verified owner';
        const p = document.createElement('p');
        p.textContent = r.text || '';
        item.appendChild(stars); item.appendChild(who); item.appendChild(p);
        list.appendChild(item);
      });
    }

    async function loadReviews(){
      try{
        const res = await fetch('/api/reviews?pieceId=drop-001');
        if(!res.ok) throw new Error('no backend');
        const data = await res.json();
        renderReviews(data.reviews || []);
      } catch(err){
        renderReviews([]); // no backend yet — honest empty state, not fabricated reviews
      }
    }
    loadReviews();

    const toggle = document.getElementById('reviewToggle');
    const form = document.getElementById('reviewForm');
    if(toggle && form){
      toggle.addEventListener('click', ()=>{
        form.hidden = !form.hidden;
        toggle.textContent = form.hidden ? 'Write a review' : 'Cancel';
      });
    }

    const starInput = document.getElementById('starInput');
    let selectedStars = 0;
    if(starInput){
      starInput.querySelectorAll('button').forEach(sbtn=>{
        sbtn.addEventListener('click', ()=>{
          selectedStars = parseInt(sbtn.dataset.star, 10);
          starInput.querySelectorAll('button').forEach(b=>{
            b.classList.toggle('filled', parseInt(b.dataset.star,10) <= selectedStars);
          });
        });
      });
    }

    if(form){
      form.addEventListener('submit', async (e)=>{
        e.preventDefault();
        const note = document.getElementById('reviewNote');
        const name = document.getElementById('reviewName').value.trim();
        const text = document.getElementById('reviewText').value.trim();
        const btn = form.querySelector('button[type="submit"]');
        const original = btn.textContent;
        if(!selectedStars){ note.textContent = 'Pick a star rating first.'; return; }
        btn.disabled = true; btn.textContent = 'Submitting…';
        note.textContent = '';
        try{
          const res = await fetch(form.dataset.endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ pieceId: form.dataset.pieceId, rating: selectedStars, name, text })
          });
          if(!res.ok) throw new Error('unavailable');
          note.textContent = 'Thanks — your review is in.';
          trackEvent('submit_review', 'Lead', { content_name: 'review' });
          form.reset();
          selectedStars = 0;
          starInput.querySelectorAll('button').forEach(b=>b.classList.remove('filled'));
          loadReviews();
        } catch(err){
          note.textContent = `This needs ${form.dataset.endpoint} on the backend to actually save reviews.`;
        } finally {
          btn.disabled = false; btn.textContent = original;
        }
      });
    }
  })();

  // ---- size chip selection ----
  document.querySelectorAll('.size-row').forEach(row=>{
    row.querySelectorAll('.size-chip:not(:disabled)').forEach(chip=>{
      chip.addEventListener('click', ()=>{
        row.querySelectorAll('.size-chip').forEach(c=>c.classList.remove('selected'));
        chip.classList.add('selected');
      });
    });
  });

  // ---- countdown to next release (drives shop card + top bar) ----
  const NEXT_DROP_AT = new Date('2026-10-01T12:00:00Z');
  const dateLabel = document.getElementById('next-drop-date');
  if(dateLabel){
    dateLabel.textContent = NEXT_DROP_AT.toLocaleDateString(undefined, { month:'short', day:'numeric' });
  }
  function tickCountdown(){
    const diff = NEXT_DROP_AT.getTime() - Date.now();
    const days = Math.max(0, Math.floor(diff / 86400000));
    const hours = Math.max(0, Math.floor((diff % 86400000) / 3600000));
    const mins = Math.max(0, Math.floor((diff % 3600000) / 60000));
    const pad = n => String(n).padStart(2,'0');
    const d = document.getElementById('cd-days'), h = document.getElementById('cd-hours'), m = document.getElementById('cd-mins');
    if(d) d.textContent = pad(days);
    if(h) h.textContent = pad(hours);
    if(m) m.textContent = pad(mins);
    const tb = document.getElementById('tb-time');
    if(tb) tb.textContent = `${days}d ${pad(hours)}h ${pad(mins)}m`;
  }
  tickCountdown();
  setInterval(tickCountdown, 30000);

  // ---- Buy button — calls the real checkout endpoint if this page is served
  // alongside the SQVEL backend (see /api/create-checkout-session). Fails
  // gracefully with an honest message when that backend isn't deployed here. ----
  document.querySelectorAll('.buy-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const pieceId = btn.dataset.pieceId;
      const note = document.querySelector(`[data-note-for="${pieceId}"]`);
      const original = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Opening checkout…';
      if(note) note.textContent = '';
      trackEvent('add_to_cart', 'AddToCart', { item_id: pieceId, value: 180, currency: 'USD' });
      try{
        const res = await fetch('/api/create-checkout-session', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ pieceId })
        });
        if(!res.ok) throw new Error('checkout unavailable');
        const data = await res.json();
        if(data.url){
          trackEvent('begin_checkout', 'InitiateCheckout', { item_id: pieceId, value: 180, currency: 'USD' });
          window.location.href = data.url; return;
        }
        throw new Error('no checkout url returned');
      } catch(err){
        if(note) note.textContent = 'Checkout isn\'t live on this page yet — connect it to the backend\'s /api/create-checkout-session.';
      } finally {
        btn.disabled = false;
        btn.textContent = original;
      }
    });
  });

  // ---- Lead capture forms (next-drop notify, Circle signup, modal offer) —
  // each attempts a real POST to its declared endpoint and shows an honest
  // fallback message if that backend route isn't deployed yet. ----
  document.querySelectorAll('.lead-form').forEach(form => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const endpoint = form.dataset.endpoint;
      const dropId = form.dataset.dropId;
      const email = form.querySelector('input[type="email"]').value;
      const note = document.querySelector(`[data-note-for="${dropId}"]`);
      const btn = form.querySelector('button');
      const original = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Saving…';
      try{
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, dropId })
        });
        if(!res.ok) throw new Error('endpoint unavailable');
        if(note) note.textContent = 'Saved — watch your inbox.';
        trackEvent('generate_lead', 'Lead', { content_name: dropId });
        form.reset();
      } catch(err){
        if(note) note.textContent = `This form needs ${endpoint} on the backend to actually save emails.`;
      } finally {
        btn.disabled = false;
        btn.textContent = original;
      }
    });
  });

  // ---- exit/scroll-intent offer modal (once per session) ----
  const modalBackdrop = document.getElementById('modalBackdrop');
  const modalClose = document.getElementById('modalClose');
  function openModal(){
    if(!modalBackdrop) return;
    let shown = false;
    try{ shown = sessionStorage.getItem('sqvel_modal_shown') === '1'; }catch(err){}
    if(shown) return;
    modalBackdrop.classList.add('show');
    try{ sessionStorage.setItem('sqvel_modal_shown', '1'); }catch(err){}
  }
  function closeModal(){ if(modalBackdrop) modalBackdrop.classList.remove('show'); }
  if(modalClose) modalClose.addEventListener('click', closeModal);
  if(modalBackdrop) modalBackdrop.addEventListener('click', (e)=>{ if(e.target === modalBackdrop) closeModal(); });
  let modalTriggered = false;
  window.addEventListener('scroll', ()=>{
    if(modalTriggered) return;
    if(window.scrollY > window.innerHeight * 2.2){
      modalTriggered = true;
      setTimeout(openModal, 400);
    }
  }, {passive:true});
  document.addEventListener('mouseleave', (e)=>{
    if(modalTriggered) return;
    if(e.clientY <= 0){ modalTriggered = true; openModal(); }
  });
</script>

</body>
</html>
